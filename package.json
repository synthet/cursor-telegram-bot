{
  "name": "agent-remote-control",
  "version": "0.1.0",
  "private": true,
  "description": "Cursor + VS Code remote control via Telegram, MCP, and hooks",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:bridge": "pnpm --filter @agent-remote/bridge run dev",
    "clean": "pnpm -r exec rimraf dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
