# Non-secret bridge configuration
AGENT_REMOTE_BRIDGE_HOST=127.0.0.1
AGENT_REMOTE_BRIDGE_PORT=0
AGENT_REMOTE_LOG_LEVEL=info

# Local dev only (gitignored .env). Extension path: SecretStorage via
# "Agent Remote: Configure Telegram Token".
# AGENT_REMOTE_TELEGRAM_TOKEN=

# Set by extension when starting bridge (ephemeral per session)
# AGENT_REMOTE_BRIDGE_URL=http://127.0.0.1:PORT
# AGENT_REMOTE_BRIDGE_TOKEN=

# Cursor SDK (optional, for SdkAgentAdapter)
# CURSOR_API_KEY=
