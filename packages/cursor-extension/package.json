{
  "name": "@agent-remote/cursor-extension",
  "version": "0.1.0",
  "private": true,
  "displayName": "Agent Remote Control (Cursor)",
  "description": "Cursor-specific integration for Agent Remote Control",
  "publisher": "agent-remote",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "extensionDependencies": ["agent-remote.vscode-extension"],
  "contributes": {
    "commands": [
      {
        "command": "agentRemote.cursorDiagnostics",
        "title": "Agent Remote: Cursor Diagnostics"
      }
    ]
  },
  "scripts": {
    "build": "tsup src/extension.ts --format cjs --platform node --external vscode",
    "dev": "tsup src/extension.ts --format cjs --platform node --external vscode --watch"
  },
  "dependencies": {
    "@agent-remote/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.85.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
